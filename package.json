{
  "name": "task-management-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n \"CLIENT,SERVER\" -c \"cyan,magenta\" \"vite\" \"node --watch server/index.js\"",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "test:server": "npm --prefix server test",
    "verify": "npm run lint && npm run build && npm run test:server",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
