# MySQL Database Configuration
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
ADMIN_EMAIL=muralisubbu11@gmail.com
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=task_management_db
DB_PORT=3306
# Required: generate a random value with at least 32 characters.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# Frontend API path. Keep /api when using the Vite development proxy.
VITE_API_URL=/api

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Task Management System" <notifications@taskmanagement.local>
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Task Deadline Reminder Scheduler Configuration
TASK_REMINDER_HOUR=9
TASK_REMINDER_MINUTE=0
TASK_TIMEZONE=Asia/Kolkata
TASK_REMINDER_TEST_MODE=false

# Protects manual reminder/test endpoints. Never enable in production.
ENABLE_DEV_TOOLS=false
